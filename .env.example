# Copy to .env and fill in. Every key is optional; each one unlocks one data source.
# Without TOMTOM_API_KEY the services still run: drive times come back as "unknown"
# and the commute gate fails closed.

# TomTom Routing + Search API: traffic-aware drive times and project geocoding.
# https://developer.tomtom.com/
TOMTOM_API_KEY=

# Optional, reserved for alternative providers (not required by any test).
GOOGLE_MAPS_KEY=
FIRECRAWL_API_KEY=
